# Checkpoint name passed to Router.predict. typed-decisions is the scoring model.
LAYA_MODEL=typed-decisions

# Optional Hugging Face revision. Leave empty to use the current hub checkpoint.
LAYA_CHECKPOINT=

# Optional combined resume + job-description token budget.
# Unset uses the checkpoint limit minus a safety margin.
# LAYA_INPUT_TOKEN_BUDGET=

# Local structured extraction. Ollama must be running before this is enabled.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b-instruct-q5_K_M
# Leave false to keep the public score path on the original resume and job text.
LLM_EXTRACTION_ENABLED=false
# Leave false to keep the broad Laya score. True uses requirement-level Laya scoring.
REQUIREMENT_MATCHING_ENABLED=false
